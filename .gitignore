# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
venv_gpu/
venv_cpu/
env/
*venv*/

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Runtime artifacts (directories tracked via .gitkeep, contents ignored)
logs/*
!logs/.gitkeep
screenshots/*
!screenshots/.gitkeep
reports/*
!reports/.gitkeep

# Local databases
*.db
*.sqlite
*.sqlite3

# Model weights (large binaries; distributed separately)
assets/models/*
!assets/models/.gitkeep
*.pt
*.onnx
*.engine

# Local config overrides
config/local.yaml

# Training artifacts and datasets (large, project-specific). Keep the
# scaffolding (README + sample data.yaml) but ignore actual data and runs.
runs/
datasets/**
!datasets/README.md
!datasets/safety/
!datasets/safety/data.yaml
